  "query": "\n                        SELECT \n                          id,\n                          symbol as \"symbol: models::TradeSymbol\",\n                          ship_symbol,\n                          purchase_waypoint,\n                          sell_waypoint,\n                          status as \"status: ShipmentStatus\",\n                          trade_volume,\n                          purchase_trade_good_id,\n                          sell_trade_good_id,\n                          estimated_fuel,\n                          trade_mode as \"trade_mode: crate::TradeMode\",\n                          reserved_fund,\n                          fleet_id,\n                          assignment_id,\n                          created_at\n                         FROM trade_route\n                         WHERE ship_symbol = $1\n                         ORDER BY created_at DESC, id DESC\n                         LIMIT $2 OFFSET $3\n                    ",
