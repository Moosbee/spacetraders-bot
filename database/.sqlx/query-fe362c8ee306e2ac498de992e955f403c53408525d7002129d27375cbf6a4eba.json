  "query": "\n            SELECT DISTINCT ON (symbol)\n                id,\n                symbol,\n                account_id,\n                headquarters,\n                credits,\n                starting_faction,\n                ship_count,\n                created_at\n            FROM agent\n            WHERE symbol = ANY($1)\n            ORDER BY symbol ASC, created_at DESC\n            ",
