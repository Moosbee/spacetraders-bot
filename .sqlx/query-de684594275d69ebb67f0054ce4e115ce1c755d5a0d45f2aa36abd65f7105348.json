  "query": "\n                SELECT \n                    id,\n                    ship_symbol,\n                    state as \"state: ShipTransferState\",\n                    fleet_id,\n                    assignment_id,\n                    start_system_symbol,\n                    end_system_symbol,\n                    reservation_id,\n                    created_at,\n                    updated_at\n                FROM ship_transfers\n                WHERE ship_symbol = $1 AND fleet_id = $2 AND assignment_id = $3 AND state = 'ON_GOING'\n                ORDER BY id ASC\n            ",
